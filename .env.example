# ApproveRail Environment Variables Configuration
# Copy this file to .env or .env.local for local development.

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/approve_rail
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# Security and Auth (Phase 2+)
# SESSION_SECRET=min-32-char-random-string-placeholder-for-future-phases
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME="ApproveRail"
# WEBAUTHN_ORIGIN=http://localhost:3000

# External Providers (Deferred to later phases)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=sandbox
# GEMINI_API_KEY=
# CHANNEL3_API_KEY=
# ZAPIER_WEBHOOK_URL=
