# ApproveRail Environment Variables Template
# Copy to .env.local for local development. Never commit secret values to version control.

# Core Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL / Neon / Render Postgres)
# Example: postgresql://user:password@localhost:5432/approverail
DATABASE_URL=
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10

# Security & WebAuthn Passkeys
# Generate a secure 32+ character random string for production
SESSION_SECRET=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ApproveRail
WEBAUTHN_ORIGIN=http://localhost:3000
DEV_AUTH_PIN=123456

# Channel3 Live Catalog API (Optional for browsing; required for live provider search)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CATALOG_PROVIDER=auto

# Google Gemini API (Optional; used for automated research synthesis if configured)
GEMINI_API_KEY=

# PayPal Orders v2 Settlement (Optional for checkout demo; sandbox recommended for dev)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Zapier Webhook Notifications (Optional)
ZAPIER_WEBHOOK_URL=
